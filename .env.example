# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change-me-please-long-random-string
JWT_EXPIRES_IN=7d
JWT_ISSUER=orcamentos-api
JWT_AUDIENCE=web
ENFORCE_HTTPS=false

# Database (Prisma/MySQL)
# Example (local): mysql://user:password@localhost:3306/dbname
# Example (Railway): mysql://root:password@host:port/railway
DATABASE_URL=mysql://user:password@host:3306/dbname

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Printer (ESC/P-R over TCP 9100)
PRINTER_IP=192.168.0.50
PRINTER_PORT=9100
PRINTER_DPI=300
PRINTER_CHUNK_SIZE=8192
PRINTER_SOCKET_TIMEOUT_MS=15000
PRINTER_CONNECT_TIMEOUT_MS=8000
PRINTER_MAX_RETRIES=2
PRINTER_RETRY_DELAY_MS=1000
PRINTER_DITHER=true
PRINTER_CONTRAST=1.0
PRINTER_BRIGHTNESS=0.0
PRINTER_PROTOCOL=escpr # escpr | escp2
